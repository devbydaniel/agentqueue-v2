{
  "name": "agentqueue-v2",
  "version": "1.0.0",
  "description": "Centralized agent orchestrator for AI agent workloads",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "typecheck": "tsc --noEmit",
    "deps:check": "npx depcruise src --config .dependency-cruiser.cjs --output-type err",
    "db:new": "dbmate --migrations-dir src/database/migrations --no-dump-schema new",
    "db:migrate": "dbmate --migrations-dir src/database/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir src/database/migrations --no-dump-schema rollback",
    "db:status": "dbmate --migrations-dir src/database/migrations --no-dump-schema status",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.101",
    "@arizeai/openinference-instrumentation-claude-agent-sdk": "0.2.2",
    "@arizeai/phoenix-otel": "0.4.3",
    "@linear/sdk": "80.1.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/sdk-node": "0.214.0",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "17.3.1",
    "js-yaml": "4.1.1",
    "node-cron": "4.2.1",
    "pg": "8.20.0",
    "pg-boss": "12.15.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.1",
    "@nestjs/testing": "11.1.17",
    "@testcontainers/postgresql": "11.14.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.13.10",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "dbmate": "2.28.0",
    "dependency-cruiser": "17.3.10",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-prettier": "5.2.5",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "3.0.2",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jscpd": "4.0.5",
    "markdownlint-cli2": "0.17.2",
    "prettier": "3.5.3",
    "supertest": "7.2.2",
    "testcontainers": "11.14.0",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "tsc-files": "1.1.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.26.1"
  }
}
