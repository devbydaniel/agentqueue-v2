{
  "name": "agentqueue-v2",
  "version": "1.0.0",
  "description": "Centralized agent orchestrator for AI agent workloads",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "typecheck": "tsc --noEmit",
    "deps:check": "npx depcruise src --config .dependency-cruiser.cjs --output-type err",
    "db:new": "dbmate --migrations-dir src/database/migrations --no-dump-schema new",
    "db:migrate": "dbmate --migrations-dir src/database/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir src/database/migrations --no-dump-schema rollback",
    "db:status": "dbmate --migrations-dir src/database/migrations --no-dump-schema status",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.215",
    "@arizeai/phoenix-otel": "1.2.0",
    "@linear/sdk": "82.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@slack/bolt": "4.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "grammy": "1.45.1",
    "js-yaml": "4.1.1",
    "node-cron": "4.6.0",
    "pg": "8.22.0",
    "pg-boss": "12.26.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "11.14.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.6.0",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "dbmate": "2.34.1",
    "dependency-cruiser": "17.3.10",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jscpd": "4.0.9",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "testcontainers": "11.14.0",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsc-files": "1.1.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0"
  }
}
