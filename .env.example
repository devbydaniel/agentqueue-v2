# Copy to .env and fill in values
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://agentqueue:agentqueue@localhost:5433/agentqueue

# Queue
QUEUE_CONCURRENCY=5
QUEUE_RETRY_LIMIT=3

# Trigger before-hook timeout in milliseconds (default: 30000)
BEFORE_HOOK_TIMEOUT=30000

# Langfuse (optional — tracing disabled when not set)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
