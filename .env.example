# Copy to .env and fill in values
NODE_ENV=development
PORT=3000

# Authentication (required)
AUTH_TOKEN=change-in-production

# Database (overridden by docker-compose.yml for production)
DATABASE_URL=postgres://agentqueue:agentqueue@localhost:5433/agentqueue

# Queue
QUEUE_CONCURRENCY=5
QUEUE_RETRY_LIMIT=3

# Run timeout (default: 30 minutes)
RUN_TIMEOUT_MS=1800000

# Trigger before-hook timeout in milliseconds (default: 30000)
BEFORE_HOOK_TIMEOUT=30000

# Tracing provider: "langfuse" | "phoenix" | "none" (auto-detects if omitted)
# TRACING_PROVIDER=

# Langfuse (auto-detected when LANGFUSE_SECRET_KEY is set)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Phoenix / Arize (auto-detected when PHOENIX_COLLECTOR_ENDPOINT is set)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=agentqueue

# Telegram trigger secrets are typically referenced from ~/.agentqueue/triggers.yaml
# TELEGRAM_MAIN_BOT_TOKEN=
# TELEGRAM_MAIN_WEBHOOK_SECRET=
