# Copy to .env and fill in values
NODE_ENV=development
PORT=3000

# Authentication (required)
AUTH_TOKEN=change-in-production

# Claude Agent SDK credential.
# Leave unset if the host has Claude Code installed and logged in
# (~/.claude/.credentials.json) — the SDK falls back to those credentials.
# Otherwise set a plain API key here.
# ANTHROPIC_API_KEY=

# Database (overridden by docker-compose.yml for production)
DATABASE_URL=postgres://agentqueue:agentqueue@localhost:5433/agentqueue

# Queue
QUEUE_CONCURRENCY=5
QUEUE_RETRY_LIMIT=3

# Run timeout (default: 30 minutes)
RUN_TIMEOUT_MS=1800000

# Trigger before-hook timeout in milliseconds (default: 30000)
BEFORE_HOOK_TIMEOUT=30000

# Tracing provider: "langfuse" | "phoenix" | "none" (auto-detects if omitted)
# TRACING_PROVIDER=

# Langfuse (auto-detected when LANGFUSE_SECRET_KEY is set)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Phoenix / Arize (auto-detected when PHOENIX_COLLECTOR_ENDPOINT is set)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=agentqueue

# Telegram bot tokens are referenced from ~/.agentqueue/triggers.yaml as ${VAR}.
# Add one env var per bot — example:
# TELEGRAM_BOT_TOKEN_DANIEL=
# TELEGRAM_BOT_TOKEN_NASTI=

# Mistral Voxtral API key — required for voice/audio transcription.
# If unset, voice messages are rejected with a friendly error.
# MISTRAL_API_KEY=

# Slack bot tokens and signing secrets are referenced from
# ~/.agentqueue/triggers.yaml as ${VAR}. Add one pair per bot:
# SLACK_BOT_TOKEN_MYBOT=xoxb-...
# SLACK_SIGNING_SECRET_MYBOT=...
